      "title": "LOG INGESTION VELOCITY & ERROR MONITORING",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Log Throughput by Service (lines/sec)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (service) (rate({container=~\".+\", service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "cps"
        }
      }
    },
    {
      "id": 2,
      "title": "Error Rate Velocity by Service",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (service) (rate({container=~\".+\", service=~\"$service\", level=\"ERROR\"}[1m]))",
          "legendFormat": "{{service}} (ERROR)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 25
          },
          "unit": "cps"
        }
      }
    },
    {
      "id": 3,
      "title": "Total Errors (Selected Range)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(count_over_time({container=~\".+\", service=~\"$service\", level=\"ERROR\"}[$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {

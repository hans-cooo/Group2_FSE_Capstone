    {
      "name": "04. Double-Entry Ledger & Concurrency Control",
      "item": [
        {
          "name": "4.1 Atomic Double-Entry Fund Transfer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const idemp = pm.variables.replaceIn('{{$guid}}');",
                  "const corr = pm.variables.replaceIn('{{$guid}}');",
                  "const ref = 'REF-POSTMAN-' + Math.floor(Math.random() * 900000 + 100000);",
                  "pm.environment.set(\"last_idempotency_key\", idemp);",
                  "pm.environment.set(\"current_transfer_corr_id\", corr);",
                  "pm.environment.set(\"current_transfer_ref\", ref);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Transfer executed with 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Double-entry balances reconciled\", function () {",
                  "    pm.expect(data.status).to.eql(\"COMPLETED\");",
                  "    pm.expect(data.sourceAccountId).to.eql(1);",
                  "    pm.expect(data.destinationAccountId).to.eql(2);",
                  "    pm.expect(parseFloat(data.sourceNewBalance)).to.be.below(parseFloat(data.sourcePreviousBalance));",
                  "    pm.expect(parseFloat(data.destinationNewBalance)).to.be.above(parseFloat(data.destinationPreviousBalance));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{last_idempotency_key}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{current_transfer_corr_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": 1,\n  \"destinationAccountId\": 2,\n  \"amount\": 25.00,\n  \"referenceNo\": \"{{current_transfer_ref}}\",\n  \"remarks\": \"Automated Postman Golden Path Transfer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ledger/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ledger",
                "transfers"
              ]
            }
          }
        },
        {
          "name": "4.2 Idempotency Mutex Replay Protection (Zero Duplicate Deduction)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Idempotent replay succeeds without duplicate execution\", function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Transfer reference matches original transaction\", function () {",
                  "    pm.expect(data.transferReference || data.referenceNo).to.eql(pm.environment.get(\"current_transfer_ref\"));",
                  "});",
                  "pm.test(\"Response time is sub-50ms (Redis pre-flight hit)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(100);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{last_idempotency_key}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": 1,\n  \"destinationAccountId\": 2,\n  \"amount\": 25.00,\n  \"referenceNo\": \"{{current_transfer_ref}}\",\n  \"remarks\": \"Automated Postman Golden Path Transfer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ledger/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ledger",
                "transfers"
              ]
            }
          }
        },
        {
          "name": "4.3 Concurrency & Invariant Negative Test - Insufficient Funds",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Overdraft blocked with 400 or 422 Problem Details\", function () {",
                  "    pm.expect([400, 422]).to.include(pm.response.code);",
                  "});",
                  "var err = pm.response.json();",
                  "pm.test(\"Error detail indicates insufficient balance\", function () {",
                  "    pm.expect((err.detail || err.message).toLowerCase()).to.include(\"insufficient\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": 1,\n  \"destinationAccountId\": 2,\n  \"amount\": 999999999.00,\n  \"referenceNo\": \"REF-OVERDRAFT-TEST\",\n  \"remarks\": \"Should be rejected by ledger balance engine\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ledger/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ledger",
                "transfers"
              ]
            }
          }
        },
        {
          "name": "4.4 Invariant Negative Test - Self-Transfer Rejection",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Self-transfer rejected with 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": 1,\n  \"destinationAccountId\": 1,\n  \"amount\": 50.00,\n  \"referenceNo\": \"REF-SELF-TEST\",\n  \"remarks\": \"Invalid self-transfer\"\n}"

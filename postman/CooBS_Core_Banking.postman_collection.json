          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const unique = Date.now().toString().slice(-6);",
                  "pm.environment.set(\"dynamic_username\", \"cust_\" + unique);",
                  "pm.environment.set(\"dynamic_email\", \"user_\" + unique + \"@bankgroup2.fse\");",
                  "pm.environment.set(\"dynamic_mobile\", \"+63917\" + unique);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Customer Registration returns 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Cryptographic JWT pair received\", function () {",
                  "    pm.expect(data.accessToken).to.not.be.empty;",
                  "    pm.expect(data.userId).to.be.a(\"number\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{dynamic_username}}\",\n  \"password\": \"Password123!\",\n  \"email\": \"{{dynamic_email}}\",\n  \"firstName\": \"Automated\",\n  \"lastName\": \"Tester\",\n  \"middleInitial\": \"T\",\n  \"address\": \"88 Financial Center, Makati City\",\n  \"mobileNumber\": \"{{dynamic_mobile}}\",\n  \"civilStatus\": \"Single\",\n  \"occupation\": \"QA Automation Specialist\"\n}"
            },

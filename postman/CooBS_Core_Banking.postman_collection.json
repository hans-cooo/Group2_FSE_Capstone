    {
      "name": "06. Forensic Cryptographic Audit & Integrity Verification",
      "item": [
        {
          "name": "6.1 Account Forensic Mutation Statement (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statement query returns 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Statement contains immutable audit entries\", function () {",
                  "    pm.expect(data.totalElements).to.be.at.least(1);",
                  "    var records = data.content;",
                  "    pm.expect(records).to.be.an(\"array\");",
                  "    pm.expect(records[0]).to.have.property(\"currentHash\");",
                  "    pm.expect(records[0]).to.have.property(\"amount\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": {

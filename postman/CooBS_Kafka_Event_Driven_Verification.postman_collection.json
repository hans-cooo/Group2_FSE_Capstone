                  "        return n.title === \"KYC Update Approved\" && n.message.includes(\"#\" + reqId);",
                  "    });",
                  "    pm.expect(found, \"Expected Kafka consumer to persist KYC approval notification\").to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/my-notifications?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "my-notifications"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",

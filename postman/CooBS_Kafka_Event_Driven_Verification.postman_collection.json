{
  "info": {
    "_postman_id": "c00b5-kafka-verification-v1",
    "name": "CooBS - Kafka Event-Driven Verification",
    "description": "Automated, reusable test suite verifying end-to-end Apache Kafka event publishing and consumption across ledger-service, account-service, and notification-service.\n\nDesigned to run using 'CooBS Local Environment' (CooBS_Local.postman_environment.json).\n\nVerifies:\n1. Successful transfer -> produces ledger.transfer.completed.v1 -> consumed by notification-service (Sender & Recipient notified)\n2. Failed transfer -> produces ledger.transfer.failed.v1 -> consumed by notification-service (Failure alert generated)\n3. KYC Update Submitted -> produces kyc.request.submitted.v1 -> consumed by notification-service\n4. KYC Update Approved -> produces kyc.request.evaluated.v1 -> consumed by notification-service\n5. KYC Update Rejected -> produces kyc.request.evaluated.v1 -> consumed by notification-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Auth & Session Setup",
      "item": [
        {
          "name": "1.1 Login Sender Customer (john_doe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Sender login successful (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Sender JWT token extracted\", function () {",
                  "    pm.expect(data.authData).to.be.an('object');",
                  "    pm.expect(data.authData.accessToken).to.not.be.empty;",
                  "    pm.environment.set(\"customer_token\", data.authData.accessToken);",
                  "    if (data.authData.customerId) {",
                  "        pm.environment.set(\"customer_id\", data.authData.customerId);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{customerUsername}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/customers/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "customers", "login"]
            }
          }
        },
        {
          "name": "1.2 Login Recipient Customer (maria_santos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Recipient login successful (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Recipient JWT token extracted\", function () {",
                  "    pm.expect(data.authData).to.be.an('object');",
                  "    pm.expect(data.authData.accessToken).to.not.be.empty;",
                  "    pm.environment.set(\"counterparty_token\", data.authData.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"maria_santos\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/customers/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "customers", "login"]
            }
          }
        },
        {
          "name": "1.3 Login Staff Teller (teller_alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Teller login successful (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Teller JWT token extracted\", function () {",
                  "    pm.expect(data.authData).to.be.an('object');",
                  "    pm.expect(data.authData.accessToken).to.not.be.empty;",
                  "    pm.environment.set(\"teller_token\", data.authData.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{tellerUsername}}\",\n  \"password\": \"{{tellerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/staff/login",
              "host": ["{{baseUrl}}"],

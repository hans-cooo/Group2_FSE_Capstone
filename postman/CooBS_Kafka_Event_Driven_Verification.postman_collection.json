              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Customer notifications fetched (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "var notifs = data.content || [];",
                  "var reqId = pm.environment.get(\"kyc_reject_req_id\");",
                  "pm.test(\"KAFKA CONSUMED: Customer has 'KYC Update Rejected' notification\", function () {",
                  "    var found = notifs.some(function(n) {",
                  "        return n.title === \"KYC Update Rejected\" && n.message.includes(\"#\" + reqId) && n.message.includes(\"Blurry identity documentation\");",
                  "    });",
                  "    pm.expect(found, \"Expected Kafka consumer to persist KYC rejection notification\").to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [

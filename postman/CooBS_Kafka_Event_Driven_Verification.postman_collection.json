          "name": "6.2 Staff - Reject KYC Update Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"KYC rejection returns 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Status updated to REJECTED with reason\", function () {",
                  "    pm.expect(data.status).to.eql(\"REJECTED\");",
                  "    pm.expect(data.rejectionReason).to.eql(\"Blurry identity documentation\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }

                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "06. Flow 5: KYC Rejection Kafka Verification",
      "item": [
        {
          "name": "6.1 Customer - Submit 2nd KYC Update Request for Rejection Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"2nd KYC submission returns 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.environment.set(\"kyc_reject_req_id\", data.kycRequestId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newFirstName\": \"John\",\n  \"newLastName\": \"Doe Reject Test\",\n  \"newAddress\": \"Temporary Address for Rejection\"\n}"

                "key": "Authorization",
                "value": "Bearer {{teller_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Blurry identity documentation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/kyc/update-request/{{kyc_reject_req_id}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "kyc", "update-request", "{{kyc_reject_req_id}}", "reject"]

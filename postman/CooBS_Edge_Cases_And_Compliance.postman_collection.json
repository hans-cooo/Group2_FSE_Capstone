  "item": [
    {
      "name": "1. Security Perimeter & Token Blacklist",
      "item": [
        {
          "name": "1.1 Customer Login (Capture Token to Revoke)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer login returns 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.expect(data.authData).to.exist;",
                  "pm.environment.set('tokenToRevoke', data.authData.accessToken);",
                  "pm.collectionVariables.set('tokenToRevoke', data.authData.accessToken);",
                  "pm.environment.set('customer_token', data.authData.accessToken);",
                  "pm.collectionVariables.set('customer_token', data.authData.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{customerUsername}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/customers/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "customers",
                "login"
              ]
            }
          }
        },

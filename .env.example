# ==============================================================================
# Core Retail Banking Architecture - Environment Template (.env.example)
# Copy this file to .env (which is strictly git-ignored) and replace the values
# with secure passwords and keys for your local/staging environment.
# DO NOT commit real secrets or production credentials into source control.
# ==============================================================================

# Oracle Database Configuration (Master System of Record & Row Locks)
ORACLE_PORT=1522
ORACLE_OEM_PORT=5500
ORACLE_PASSWORD=ChangeMe_OracleSysPassword!
APP_USER=core_user
APP_USER_PASSWORD=ChangeMe_CoreUserPassword!
ORACLE_DATABASE=XEPDB1

# PostgreSQL Configuration (Immutable Forensic Audit & Compliance Store)
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe_PostgresAuditPassword!
POSTGRES_DB=audit_store

# Redis Configuration (Distributed Idempotency Lock & Balance Cache)
REDIS_PORT=6379

# Apache Kafka Configuration (KRaft Mode Event Streaming)
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
KAFKA_CLUSTER_ID=4L62EnNxTQl-GHmeeAhCwA

# Kafka UI Configuration
KAFKA_UI_PORT=8085

# Security, JWT & CORS Configuration
# Minimum 256-bit (32-byte) hex or base64 secret for HMAC-SHA256
JWT_SECRET=ReplaceWithSecureRandomHexSecretOfAtLeast256BitsLength
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
